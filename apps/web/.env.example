NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Semantic search (optional — lexical search works without these)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_SOURCE_CHUNKS_COLLECTION=aproko_source_chunks
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI providers (server-only). ChatGPT website login ≠ API key.
# Free-ish options: Groq (GROQ_API_KEY) for chat + Whisper STT; Google AI Studio (GOOGLE_GENERATIVE_AI_API_KEY)
# Speech-to-text prefers GROQ_API_KEY (whisper-large-v3-turbo), falls back to OPENAI_API_KEY (whisper-1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Optional in-app GPTZero scores (paid API; free website check works without this)
GPTZERO_API_KEY=

# Observability (Sentry project: calebsilvanus/aproko-ai, region: de.sentry.io)
# DSN from Sentry → Settings → Client Keys. Do not commit SENTRY_AUTH_TOKEN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=calebsilvanus
SENTRY_PROJECT=aproko-ai
SENTRY_AUTH_TOKEN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Admin dashboard
ADMIN_CLERK_USER_IDS=
ADMIN_ALLOW_ALL_DEV=

# Billing (Stripe)
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAMS=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_APP_URL=
