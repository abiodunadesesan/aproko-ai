{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils"
  },
  "registries": {
    "@skiper-ui": {
      "url": "https://skiper-ui.com/r/{name}.json",
      "headers": {
        "Authorization": "Bearer ${SKIPER_LICENSE_KEY}"
      }
    }
  }
}
